{
  "$schema": "../gen/schemas/mobile-schema.json",
  "identifier": "mobile",
  "description": "Handy-Apps: Standort über das Gerät und Health Connect (Android) – auch für die Webversion, die die App lädt",
  "platforms": [
    "android",
    "iOS"
  ],
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "geolocation:allow-check-permissions",
    "geolocation:allow-request-permissions",
    "geolocation:allow-watch-position",
    "geolocation:allow-clear-watch",
    "geolocation:allow-get-current-position",
    "geolocation:allow-start-recording",
    "geolocation:allow-stop-recording",
    "geolocation:allow-take-recorded",
    "geolocation:allow-notification-state",
    "geolocation:allow-request-notification",
    "health:default",
    "folder:default",
    "browser:default"
  ],
  "remote": {
    "urls": [
      "https://app.wuefl.de/*"
    ]
  }
}
