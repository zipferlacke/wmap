{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WMap",
  "version": "2.3.0",
  "identifier": "de.wuefl.wmap",
  "build": {
    "frontendDist": "web",
    "devUrl": "http://localhost:8080/web/wuefl_products/wmap/",
    "beforeBuildCommand": "sh src-tauri/web-kopieren.sh"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WMap",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["geo"] },
      "mobile": [
        { "scheme": ["geo"], "appLink": false },
        { "scheme": ["https"], "host": "app.wuefl.de", "pathPrefix": ["/wmap"], "appLink": true }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage",
      "nsis",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug",
      "minSdkVersion": 26
    },
    "linux": {
      "deb": { "desktopTemplate": "wmap.desktop" },
      "rpm": { "desktopTemplate": "wmap.desktop" }
    },
    "fileAssociations": [
      {
        "ext": ["gpx"],
        "mimeType": "application/gpx+xml",
        "name": "GPX",
        "description": "GPS-Strecke (GPX)",
        "role": "Viewer"
      },
      {
        "ext": ["fit"],
        "mimeType": "application/vnd.ant.fit",
        "name": "FIT",
        "description": "Training (FIT)",
        "role": "Viewer"
      }
    ],
    "category": "Travel",
    "shortDescription": "Karte, Navigation und Touren auf Basis offener Daten",
    "copyright": "© 2026 Florian Wüllner"
  }
}
