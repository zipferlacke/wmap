# Token-Kopf (Authorization) an PHP weiterreichen – bei PHP-FPM/CGI nötig
CGIPassAuth On

# Von außen erreichbar: api.php, proxy.php (Weiterleitung) und stats.php (Übersicht, mit Schlüssel) – die Teile und die Datenbank nicht
<FilesMatch "\.(php)$">
    Require all denied
</FilesMatch>
<FilesMatch "^(api|proxy|stats)\.php$">
    Require all granted
</FilesMatch>
