    ],
    "file_handlers": [
        {
            "action": "../import.html",
            "accept": { "application/gpx+xml": [".gpx"], "application/vnd.ant.fit": [".fit"] },
            "icons": [{ "src": "./wmap-192.png", "sizes": "192x192", "type": "image/png" }],
            "launch_type": "single-client"
        }
    ],
    "share_target": {
        "action": "../import.html",
        "method": "POST",
        "enctype": "multipart/form-data",
        "params": {
            "files": [
                { "name": "files", "accept": [".gpx", ".fit", "application/vnd.ant.fit", "application/gpx+xml", "application/gpx", "application/octet-stream", "application/xml", "text/xml"] }
