{
    "id": "wmap",
    "name": "WMap – Karte, Routen & Navigation",
    "short_name": "WMap",
    "description": "Karte in 3D mit Suche, Routen zu Fuß, mit Rad, Auto, Bus & Bahn, Navigation mit Ansagen, Touren planen, aufzeichnen und auswerten – auf Basis von OpenStreetMap, ohne Konto und ohne Werbung.",
    "lang": "de",
    "dir": "ltr",
    "start_url": "../index.html",
    "scope": "../",
    "display": "standalone",
    "display_override": [
        "standalone",
        "window-controls-overlay",
        "fullscreen"
    ],
    "orientation": "any",
